 #include <linux/string.h>
 
+#define KX_COMPAT	"samsung,b0s-kexec-boot"
+
+static void __iomem *__init kx_map(struct device_node *np, const char *name, resource_size_t *sz)
+{
+	struct resource r;
+	int i = of_property_match_string(np, "reg-names", name);
+
+	if (i < 0 || of_address_to_resource(np, i, &r))
+		return NULL;
+	if (sz)
+		*sz = resource_size(&r);
+	return ioremap(r.start, resource_size(&r));
+}
+
 /* ------------------------------------------------------------------ PMIC via ACPM */
-#define SRAM_PA		0x02060000
-#define SRAM_SZ		0x50000
 #define INITDATA	0xF800
-#define MBOX_PA		0x15900000
