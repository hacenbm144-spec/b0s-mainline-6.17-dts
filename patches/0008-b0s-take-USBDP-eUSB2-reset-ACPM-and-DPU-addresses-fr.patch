 #include <linux/iopoll.h>
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
@@ -1302,7 +1303,7 @@ static const struct phy_ops exynos7870_usbdrd_phy_ops = {
 	.owner		= THIS_MODULE,
 };
 
-#define EXYNOS2200_EUSB2_RST_CTRL		0x10ab0000
+#define EUSB2_RST_CTRL			0x0
 #define EUSB2_RST_CTRL_PHY_RESET		BIT(0)
 #define EUSB2_RST_CTRL_PHY_RESET_OVRD_EN	BIT(1)
 
@@ -1318,24 +1319,30 @@ static void exynos2200_usbdrd_utmi_init(struct exynos5_usbdrd_phy *phy_drd)
 	 * Keep the eUSB2 PHY reset owned by its register (as the vendor kernel
 	 * does), so the DWC3 core soft reset cannot reset the eUSB2 PHY and stop
 	 * utmi_clk underneath itself.
-	 * TODO: belongs in the eUSB2 PHY driver / a DT reg entry.
+	 * The register is the first word of the eUSB2 PHY's own DT region.
 	 */
-	rst = ioremap(EXYNOS2200_EUSB2_RST_CTRL, 4);
+	if (IS_ERR_OR_NULL(phy_drd->hs_phy))
+		return;
+	rst = of_iomap(phy_drd->hs_phy->dev.of_node, 0);
 	if (!rst)
 		return;
-	reg = readl(rst);
+	reg = readl(rst + EUSB2_RST_CTRL);
 	reg &= ~EUSB2_RST_CTRL_PHY_RESET;
 	reg |= EUSB2_RST_CTRL_PHY_RESET_OVRD_EN;
-	writel(reg, rst);
+	writel(reg, rst + EUSB2_RST_CTRL);
 	iounmap(rst);
 }
 
 /* SNPS USBDP combo PHY (RAM-mode SRAM firmware) bring-up, phy-exynos2200-usbdp.c */
-int exynos2200_usbdp_boot(void);
+int exynos2200_usbdp_boot(struct device_node *np);
 
 static void exynos2200_usbdrd_pipe3_init(struct exynos5_usbdrd_phy *phy_drd)
 {
-	int ret = exynos2200_usbdp_boot();
+	struct device_node *np = of_parse_phandle(phy_drd->dev->of_node,
+						  "samsung,usbdp-phy", 0);
+	int ret = exynos2200_usbdp_boot(np);
+
+	of_node_put(np);
 
 	if (ret)
 		dev_err(phy_drd->dev, "USBDP combo PHY boot failed: %d\n", ret);
diff --git a/drivers/soc/samsung/kx-b0s-boot.c b/drivers/soc/samsung/kx-b0s-boot.c
