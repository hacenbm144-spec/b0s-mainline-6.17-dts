From 70c31ecb2b721ef717eb14b83ee1326d5c997403 Mon Sep 17 00:00:00 2001
From: hacen <hacenbm144@gmail.com>
Date: Fri, 9 Oct 2026 18:02:28 +0000
Subject: [PATCH 8/9] b0s: take USBDP, eUSB2 reset, ACPM and DPU addresses from
 the device tree

- new node samsung,exynos2200-usbdp-phy (ctrl/tca, pmu, cmu-hsi0), referenced by
  the DRD PHY as samsung,usbdp-phy; eUSB2 reset register from the eUSB2 PHY node
- kx-b0s-boot: /chosen/kexec-boot node (reg-names, pmu syscon, memory-region,
  framebuffer); fb size and carve-out from DT

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/exynos/exynos2200-b0s-kx.dts     |  51 ++-
 drivers/phy/samsung/phy-exynos2200-usbdp.c    |  53 ++--
 drivers/phy/samsung/phy-exynos5-usbdrd.c      |  21 +-
 drivers/soc/samsung/kx-b0s-boot.c             | 293 ++++++++++--------
 4 files changed, 265 insertions(+), 153 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos2200-b0s-kx.dts b/arch/arm64/boot/dts/exynos/exynos2200-b0s-kx.dts
index a911629d6..f31ebd652 100755
--- a/arch/arm64/boot/dts/exynos/exynos2200-b0s-kx.dts
+++ b/arch/arm64/boot/dts/exynos/exynos2200-b0s-kx.dts
@@ -93,7 +93,7 @@ chosen {
 			    0x91e3d48c 0x6df185e5 0x5930ec18 0x5990dc88 0xd9099c31 0x8b6cdadb 0xf2f8012d 0x5f4f0449>;
 
 		/* the DPU scans out kx_fb (k1b221); simpledrm + fbcon draw into it */
-		framebuffer@d0000000 {
+		kx_simplefb: framebuffer@d0000000 {
 			compatible = "simple-framebuffer";
 			reg = <0x0 0xd0000000 0x0 0x10f6800>;
 			width = <1440>;
@@ -105,7 +105,7 @@ framebuffer@d0000000 {
 	};
 
 	reserved-memory {
-		kx_fb@d0000000 { reg = <0x0 0xd0000000 0x0 0x2000000>; no-map; };
+		kx_fb: kx_fb@d0000000 { reg = <0x0 0xd0000000 0x0 0x2000000>; no-map; };
 	};
 };
 
@@ -164,3 +164,50 @@ &usb_dwc3 {
 	/delete-property/ usb-role-switch;
 	/delete-property/ role-switch-default-mode;
 };
+
+/* ---- k1b235: addresses the kernel used to hard-code ---- */
+
+/ {
+	chosen {
+		/*
+		 * kexec bring-up helpers (drivers/soc/samsung/kx-b0s-boot.c). Under /chosen so no
+		 * platform device claims these windows.
+		 */
+		kexec-boot@2060000 {
+			compatible = "samsung,b0s-kexec-boot";
+			reg = <0x0 0x02060000 0x0 0x50000>,
+			      <0x0 0x15900000 0x0 0x1000>,
+			      <0x0 0x19f00000 0x0 0x1000>,
+			      <0x0 0x19f10000 0x0 0x10000>,
+			      <0x0 0x19f30000 0x0 0x10000>,
+			      <0x0 0x1ad0e000 0x0 0x1000>,
+			      <0x0 0x1ad00000 0x0 0x8000>,
+			      <0x0 0x1af00000 0x0 0x8000>,
+			      <0x0 0x1ac40000 0x0 0x10000>,
+			      <0x0 0x1ac50000 0x0 0x10000>,
+			      <0x0 0x1ae40000 0x0 0x10000>,
+			      <0x0 0x1ae50000 0x0 0x10000>;
+			reg-names = "acpm-sram", "apm-mbox", "decon", "decon-win", "decon-wincon",
+				    "dqe-edma", "dpp-dma-a", "dpp-dma-b",
+				    "sysmmu0", "sysmmu1", "sysmmu2", "sysmmu3";
+			samsung,pmu-syscon = <&pmu_system_controller>;
+			memory-region = <&kx_fb>;
+			framebuffer = <&kx_simplefb>;
+		};
+	};
+};
+
+&{/soc} {
+	usbdp_phy: phy@10ad0000 {
+		compatible = "samsung,exynos2200-usbdp-phy";
+		reg = <0x0 0x10ad0000 0x0 0x1000>,
+		      <0x0 0x10ae0000 0x0 0x100>;
+		reg-names = "ctrl", "tca";
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		samsung,cmu-hsi0 = <&cmu_hsi0>;
+	};
+};
+
+&usb32drd {
+	samsung,usbdp-phy = <&usbdp_phy>;
+};
diff --git a/drivers/phy/samsung/phy-exynos2200-usbdp.c b/drivers/phy/samsung/phy-exynos2200-usbdp.c
index c7b39fd86..5d6fb75f1 100755
--- a/drivers/phy/samsung/phy-exynos2200-usbdp.c
+++ b/drivers/phy/samsung/phy-exynos2200-usbdp.c
@@ -7,8 +7,11 @@
  * Called from the PIPE3 instance init of phy-exynos5-usbdrd; the DWC3 core
  * soft reset needs the pipe clock that this PHY's PLL provides.
  *
- * TODO for upstream: take the bases, the PMU syscon and the Q-channel
- * register from DT instead of fixed addresses.
+ * DT node (compatible "samsung,exynos2200-usbdp-phy"), referenced from the USB
+ * DRD PHY by "samsung,usbdp-phy":
+ *   reg / reg-names     "ctrl" (CR_PARA control), "tca" (Type-C assist)
+ *   samsung,pmu-syscon  PMU (USBDP isolation at 0x730)
+ *   samsung,cmu-hsi0    CMU_HSI0 (Q-channel of the USB link at 0x3064)
  */
 #include <linux/bits.h>
 #include <linux/delay.h>
@@ -16,13 +19,11 @@
 #include <linux/io.h>
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
+#include <linux/of_address.h>
 #include <linux/printk.h>
 #include <linux/regmap.h>
 
-#define USBDP_CTRL_BASE		0x10ad0000UL
-#define USBDP_TCA_BASE		0x10ae0000UL
-#define CMU_HSI0_QCH_BASE	0x10a03000UL
-#define QCH_CON_S_LINK		0x64
+#define CMU_HSI0_QCH_CON_S_LINK	0x3064
 #define PMU_USBDP_PHY_CTRL	0x730
 
 /* CR_PARA control block */
@@ -157,32 +158,31 @@ static u16 cr_read(u16 addr)
 	return (u16)(rd(CR_PARA_CON1) >> 16);
 }
 
-static void qch_link_on(void)
+static void qch_link_on(struct device_node *np)
 {
-	void __iomem *c = ioremap(CMU_HSI0_QCH_BASE, 0x100);
+	struct device_node *cmu = of_parse_phandle(np, "samsung,cmu-hsi0", 0);
+	void __iomem *c = cmu ? of_iomap(cmu, 0) : NULL;
 	u32 v;
 
-	if (!c)
+	of_node_put(cmu);
+	if (!c) {
+		pr_warn("exynos2200-usbdp: no samsung,cmu-hsi0 - Q-channel left as is\n");
 		return;
-	v = readl(c + QCH_CON_S_LINK);
+	}
+	v = readl(c + CMU_HSI0_QCH_CON_S_LINK);
 	if (!(v & BIT(0))) {		/* manual mode: CLOCK_REQ = 1 */
-		writel(v | BIT(1), c + QCH_CON_S_LINK);
+		writel(v | BIT(1), c + CMU_HSI0_QCH_CON_S_LINK);
 		udelay(10);
 	}
 	iounmap(c);
 }
 
-static int release_isolation(void)
+static int release_isolation(struct device_node *np)
 {
-	struct device_node *np;
 	struct regmap *pmu;
 	int ret;
 
-	np = of_find_compatible_node(NULL, NULL, "samsung,exynos2200-usb32drd-phy");
-	if (!np)
-		return -ENODEV;
 	pmu = syscon_regmap_lookup_by_phandle(np, "samsung,pmu-syscon");
-	of_node_put(np);
 	if (IS_ERR(pmu))
 		return PTR_ERR(pmu);
 	ret = regmap_update_bits(pmu, PMU_USBDP_PHY_CTRL, BIT(0), BIT(0));
@@ -212,25 +212,34 @@ static int tca_usb_mode(void __iomem *tca)
 	return 0;
 }
 
-int exynos2200_usbdp_boot(void)
+static void __iomem *map_named(struct device_node *np, const char *name)
+{
+	int i = of_property_match_string(np, "reg-names", name);
+
+	return i < 0 ? NULL : of_iomap(np, i);
+}
+
+int exynos2200_usbdp_boot(struct device_node *np)
 {
 	void __iomem *tca;
 	unsigned int n, t;
 	int ret, ackmiss = 0;
 	u16 cal = 0;
 
-	qch_link_on();
+	if (!np)
+		return -ENODEV;
+	qch_link_on(np);
 
-	ctrl = ioremap(USBDP_CTRL_BASE, 0x300);
+	ctrl = map_named(np, "ctrl");
 	if (!ctrl)
 		return -ENOMEM;
-	tca = ioremap(USBDP_TCA_BASE, 0x100);
+	tca = map_named(np, "tca");
 	if (!tca) {
 		ret = -ENOMEM;
 		goto out_ctrl;
 	}
 
-	ret = release_isolation();
+	ret = release_isolation(np);
 	if (ret)
 		pr_warn("exynos2200-usbdp: PMU isolation release failed: %d\n", ret);
 
