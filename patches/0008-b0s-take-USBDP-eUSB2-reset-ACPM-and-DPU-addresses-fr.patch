-		pr_info("kx-b0s: pmic %-14s sid%u %#04x: %#04x -> %#04x (w %d)%s\n", rl->name, rl->sid, rl->en, en,
-			after, w, (after & 0xc0) == 0xc0 ? " ON" : " NOT ON");
+		pr_info("kx-b0s: pmic %-14s sid%u %#04x: %#04x -> %#04x (w %d)%s\n", rl->name, rl->sid,
