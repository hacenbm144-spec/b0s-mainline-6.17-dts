+	of_node_put(np);
+	if (!kx_sram || !kx_mbox) {
+		pr_err("kx-b0s: pmic: acpm-sram/apm-mbox missing in DT\n");
 		goto out;
+	}
 	chans = readl(kx_sram + INITDATA + 8);
