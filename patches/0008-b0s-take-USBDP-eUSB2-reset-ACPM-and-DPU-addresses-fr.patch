@@ -1,35 +1,50 @@
 // SPDX-License-Identifier: GPL-2.0
 /*
- * kx-b0s-boot - built-in bring-up helpers for the Samsung Galaxy S22 Ultra (b0s, Exynos 2200)
- * when mainline Linux is started by kexec from the stock Android kernel (k1b230).
+ * kx-b0s-boot - bring-up helpers for the Samsung Galaxy S22 Ultra (b0s, Exynos 2200) when mainline
+ * Linux is started by kexec from the stock Android kernel.
  *
- * Bench code, NOT upstream material: fixed addresses, no DT bindings. It replaces the out-of-tree
- * kxpmic.ko (k1b228) and kxdpu.ko (k1b222) with identical logic, run at fixed initcall levels:
+ * Everything comes from the DT node compatible "samsung,b0s-kexec-boot":
+ *   reg / reg-names   acpm-sram, apm-mbox, decon, decon-win, decon-wincon, dqe-edma,
+ *                     dpp-dma-a (ch 0-7), dpp-dma-b (ch 8-15), sysmmu0..3
+ *   samsung,pmu-syscon   PMU (DPU power-domain status)
+ *   memory-region        the no-map carve-out the DPU scans out (fb, then dummy page + sysmmu table)
+ *   framebuffer          the simple-framebuffer node (width/height)
  *
- *  subsys_initcall  kx_b0s_pmic: ACPM (APM SRAM 0x02060000 + initdata 0xF800, channel 2, doorbell
- *                   BIT(2) << 16 -> 0x15900008) - whitelist of six PMIC rails; per rail the voltage
- *                   field must equal Android's, then ONLY the enable field [7:6] is set to 0b11.
- *                   Android's kexec shutdown clears the UFS LDO18/19 enables (VCC 2.55 V / VCCQ 1.2 V);
- *                   the USB rails stay on. Runs before any driver probe, so UFS finds its supplies on.
- *  late_initcall_sync kx_b0s_dpu: the DPU left running by the host (kxdispkeep + kxdpuwake4) is pointed at
- *                   the simple-framebuffer at PA 0xD0000000 through our own sysmmu table at 0xD1F00000
- *                   (DQE + CGC EDMA off, full-screen window auto-detected, ARGB8888 linear, COPY blend).
- * Both only run on "samsung,b0s".
+ *  subsys_initcall  PMIC: over ACPM channel 2, a whitelist of six rails; per rail the voltage field
+ *                   must equal Android's, then ONLY the enable field [7:6] is set. Android's kexec
+ *                   shutdown clears the UFS LDO18/19 enables; runs before any driver probe.
+ *  late_initcall_sync DPU: the display pipeline left running by the host is pointed at the
+ *                   simple-framebuffer through our own sysmmu table (DQE + EDMA off, full-screen
+ *                   window auto-detected, ARGB8888 linear, COPY blend).
  */
-#include <linux/module.h>
-#include <linux/kernel.h>
+#include <linux/delay.h>
 #include <linux/init.h>
 #include <linux/io.h>
-#include <linux/of.h>
-#include <linux/delay.h>
+#include <linux/kernel.h>
 #include <linux/ktime.h>
